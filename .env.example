# Hermes & Wingman Gateway Environment Configuration Example
# Copy this file to .env and configure your secure tokens

PORT=8765
HERMES_BIN=/home/u0_a205/.local/bin/hermes

# Cryptographically Secure 256-bit Authentication Token
# Run `npm run generate:token` to generate a fresh secure token,
# or `npm run generate:token -- --write-env` to write it directly into .env.
WINGMAN_AUTH_TOKEN=wm_sec_replace_with_generated_256bit_secure_token
HERMES_GATEWAY_TOKEN=wm_sec_replace_with_generated_256bit_secure_token
